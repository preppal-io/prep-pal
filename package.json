{
  "name": "prep-pal",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "author": "PrepPal <hey@preppal.io>",
  "dependencies": {
    "@assembless/react-littera": "^2.4.0",
    "@electron/remote": "^2.0.1",
    "@mantine/core": "^8.0.0",
    "@mantine/dates": "^8.0.0",
    "@mantine/hooks": "^8.0.0",
    "@mantine/notifications": "^8.0.0",
    "@phosphor-icons/react": "^2.1.7",
    "electron-is-dev": "^2.0.0",
    "electron-log": "^5.0.3",
    "electron-updater": "^6.1.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.12.0"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "lint": "eslint src/ electron/",
    "lint:fix": "eslint src/ electron/ --fix",
    "format": "prettier --write \"src/**/*.{js,jsx}\" \"electron/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\" \"electron/**/*.js\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "electron:serve": "concurrently -k \"cross-env BROWSER=none npm start\" \"npm run electron:start\"",
    "electron:start": "wait-on tcp:3000 && electron .",
    "electron:build": "npm run build && electron-builder -c.extraMetadata.main=build/electron/main.js --publish never",
    "electron:build:mac": "npm run build && electron-builder -c.extraMetadata.main=build/electron/main.js --mac --publish never",
    "electron:build:win": "npm run build && electron-builder -c.extraMetadata.main=build/electron/main.js --win --publish never",
    "electron:build:linux": "npm run build && electron-builder -c.extraMetadata.main=build/electron/main.js --linux --publish never",
    "electron:publish": "npm run build && electron-builder -c.extraMetadata.main=build/electron/main.js --publish always",
    "electron:publish:mac": "npm run build && electron-builder -c.extraMetadata.main=build/electron/main.js --mac --publish always",
    "electron:publish:win": "npm run build && electron-builder -c.extraMetadata.main=build/electron/main.js --win --publish always",
    "electron:publish:linux": "npm run build && electron-builder -c.extraMetadata.main=build/electron/main.js --linux --publish always"
  },
  "build": {
    "appId": "io.preppal",
    "productName": "PrepPal",
    "copyright": "Copyright © 2025",
    "files": [
      "dist/**/*",
      "build/**/*",
      "node_modules/**/*",
      "electron/icons/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "preppal-io",
      "repo": "prep-pal",
      "releaseType": "release",
      "publishAutoUpdate": true
    },
    "mac": {
      "icon": "electron/icons/preppal-logo.icns",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "electron/icons/preppal-logo.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.0.16",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^39.2.7",
    "electron-builder": "^26.3.6",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "vite": "^6.2.3",
    "vitest": "^4.0.16",
    "wait-on": "^8.0.3"
  }
}
